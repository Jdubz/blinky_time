# syntax=docker/dockerfile:1
# The build service's API (build-service/README.md). Git and HTTP only: it never runs
# repository code. Python stdlib + git; no third-party packages.
FROM python:3.11-slim-bookworm@sha256:ef56ae98435cc40d8a27020b0b32a9941515acd5840f0fba34858bb34dd362d1

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

# uid 10001 in both images: the job volume is written by one and read by the other, and git
# refuses repositories owned by another user.
RUN useradd --uid 10001 --user-group --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin blinky \
 && install -d -o 10001 -g 10001 /data /jobs

COPY blinky_build /opt/blinky/app/blinky_build

ENV PYTHONPATH=/opt/blinky/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BLINKY_BUILD_DATA=/data \
    BLINKY_BUILD_JOBS=/jobs

USER 10001:10001
ENTRYPOINT ["python", "-m", "blinky_build.api"]

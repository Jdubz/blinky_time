# The labels stack's host-specific values. Copy to labels.env (gitignored) on the build host and fill
# in; nothing here may be committed with real values (the repo is public: scripts/check_topology.py).
#
# Two free /24s for the stack's own Docker networks, inside one /23 (the firewall matches the /23).
# Pick ranges no other network on the host uses (`ip route`, `docker network inspect`).
LABELS_FW_SOURCE=
# The service's way out: TCP 443 to public addresses only.
LABELS_EGRESS_SUBNET=
LABELS_EGRESS_GATEWAY=
LABELS_EGRESS_IP=
# Internal (no route out), shared with the tunnel connector and nothing else.
LABELS_EDGE_SUBNET=
LABELS_EDGE_GATEWAY=
LABELS_EDGE_IP=
# Public product names (fine to share).
LABELS_HOSTNAME=blinky-labels-api.joshwentworth.com
LABELS_SITE_ORIGIN=https://blinky-time.joshwentworth.com
LABELS_PAGE_URL=https://blinky-time.joshwentworth.com/labels/
# Fences. Keep the service off the cores the host reserves for production.
LABELS_CPUSET=
LABELS_MEM=512m
# The tunnel connector that fronts the service (it joins the edge network).
LABELS_TUNNEL_CONTAINER=

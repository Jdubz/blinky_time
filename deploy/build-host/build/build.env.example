# The build service's host-specific values. Copy to build.env (gitignored) next to this file in the
# deployer's clone on the build host and fill in; nothing here may be committed with real values (the
# repo is public: scripts/check_topology.py). Parsed by docker compose (--env-file) and sourced by
# deploy.sh and verify.sh: plain KEY=value lines, no spaces around `=`.
#
# Not the test box's ~/.config/blinky/build.env (that one holds the client's URL and token).

# Where the api listens: ONE private address of this host that the test box reaches it on (deploy.sh
# refuses a wildcard or an address the host doesn't have), and the port. The box's BLINKY_BUILD_URL
# is http://<BLINKY_BUILD_BIND>:<BLINKY_BUILD_PORT>.
BLINKY_BUILD_BIND=
BLINKY_BUILD_PORT=

# The CPUs both containers may use: keep the host's production-reserved cores out.
BLINKY_BUILD_CPUSET=

# The bearer token, read at deploy time and never written to disk: a 1Password secret reference
# (op://<vault>/<item>/<field>, at least 32 characters: `openssl rand -hex 32`) and the file holding
# the 1Password service-account token `op` reads it with (mode 600, outside this clone).
BLINKY_BUILD_TOKEN_REF=
BLINKY_BUILD_OP_TOKEN_FILE=

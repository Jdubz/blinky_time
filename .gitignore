# TFLite model binaries (the .h C header is tracked, the binary is not)
*.tflite

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
**/venv/

# ML training artifacts (large, regenerated)
ml-training/data/processed/
ml-training/data/mel_cache/
ml-training/data/archive/
ml-training/outputs/*/checkpoints/

# Synthetic corpora (deterministic, regenerate via analysis/generate_tonal_corpus.py)
blinky-test-player/music/synthetic_tonals/
blinky-test-player/music/synthetic_tonals_*/

# Held-out EDM corpus (deleted 2026-04-27, CLAUDE.md): ignored so a stale local copy never lands
blinky-test-player/music/edm_holdout/

# Parity temp files (binary mags + harness CSVs)
ml-training/outputs/parity/

# Compiled binaries (prevent accidental venv/library commits)
*.so
*.dylib
*.dll
*.whl
*.tar.gz
*.zip
*.onnx
*.pt
*.pth

# Node
node_modules/
dist/

# blinky-console build output (Vite emits here for blinky-server to serve)
blinky-server/web/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Editor scratch logs
excalidraw.log
.claude/

# Local run artifacts (never source)
test-results/
blinky-test-player/tuning-results/
previews/
.playwright-mcp/
scratch/

# Local scratch: host-test build output and deep-research notes
/build/
/reports/
/research_notes/

# Private config: host endpoints, addresses and secrets live in ~/.config/blinky/ (dir 700, files
# 600), never in this public repo. setup.sh seeds observability.env and hosts.env from copies next
# to it on first boot. Only the *.example templates are tracked; scripts/check_topology.py (CI)
# fails on topology that slips in anyway.
observability.env
hosts.env
build.env
spark.env
# Vite's private overrides (blinky-console/.env.example is the template)
.env.local
.env.*.local

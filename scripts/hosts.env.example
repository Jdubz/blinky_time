# Host endpoints for blinky's tools. A template only: copy it to ~/.config/blinky/hosts.env
# (mkdir -m 700 ~/.config/blinky; chmod 600 the file) and fill in the values. Never commit the
# real file: these repos are public, and host names and addresses are topology. The values are in
# the owner's private notes.
#
# KEY=value or KEY="value"; tools parse it, never source it. An environment variable of the same
# name overrides the file. A tool that needs a key fails, naming this file and the key, when it's
# missing or still a <placeholder>.

# The fleet server's blinky-server (production). scripts/deploy.sh.
BLINKY_SERVER_URL=http://<fleet-server>:8420

# The test box's blinky-server, as the home network reaches it. Links in the staging report
# (scripts/testbox/staging.py), and the server-API examples in the docs.
BLINKY_TESTBOX_URL=http://<test-box>:8420

# ssh target of the fleet server for the blinky-serial MCP server in .mcp.json (user@host, or an
# alias in your ssh config). Claude Code doesn't read this file: .mcp.json expands
# ${BLINKY_SERIAL_SSH} from the environment, so export it in the shell that starts `claude`
# (e.g. in ~/.profile: set -a; . ~/.config/blinky/hosts.env; set +a).
BLINKY_SERIAL_SSH=<user>@<fleet-server>

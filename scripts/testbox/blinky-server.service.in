[Unit]
Description=blinky-server (test box: USB only, --no-ble)
Documentation=https://github.com/Jdubz/blinky_time/blob/master/docs/TEST_BOX_BUILD_PLAN.md
After=network-online.target
Wants=network-online.target
# Same self-heal window as blinkyhost's lemon-cart drop-in.
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
# Type=notify + WatchdogSec: the fleet loop pings systemd every discovery cycle
# (blinky_server/systemd_notify.py); a hang gets killed and restarted.
Type=notify
NotifyAccess=main
User=@USER@
Group=@USER@
SupplementaryGroups=dialout plugdev

WorkingDirectory=@SERVER_DIR@
# --no-ble: blinky-server has no discovery allowlist yet, so with BLE on it could
# adopt (and auto-recover, i.e. flash) a production device in radio range.
ExecStart=@SERVER_DIR@/venv/bin/python -m blinky_server --no-ble
# The Spark client (#288): SPARK_JOB_API, SPARK_API_KEY, SPARK_WEBHOOK_SECRET. Optional ("-"):
# without it the server runs and its /api/spark routes answer 503. Mode 600, never in the repo.
EnvironmentFile=-@HOME_DIR@/.config/blinky/spark.env

# A stop is a drain (#325): blinky-server finishes the step or flash in flight, holding the
# stop open with EXTEND_TIMEOUT_USEC. mixed: the SIGTERM goes to the server only, never to the
# ffplay, UF2 copy or release download it is waiting for (control-group, the default, would
# kill them at once and the drain would record their failures); SIGKILL reaches every process
# only at the final timeout. scripts/testbox/deploy.py installs this unit before each stop.
KillMode=mixed

Restart=always
RestartSec=5s
WatchdogSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=blinky-server

MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target

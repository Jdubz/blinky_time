# blinky test box: passwordless sudo for exactly the commands the flash path
# runs under sudo (tools/uf2_upload.py, blinky-server firmware/uf2_upload.py).
# Everything else still needs the user's password.
# Generated by scripts/testbox/setup.sh from sudoers.in; edit that, not this.
#
# Arguments are anchored regexes (^...$, sudo >= 1.9.10), not globs: a glob `*`
# also matches spaces, so `umount /mnt/uf2-*` would allow `umount /mnt/uf2-x /`.
# In sudoers, `,` `:` `=` `\` inside a command must be backslash-escaped.
# usb_reset.py is a root-owned copy (@USB_RESET@); a rule on the user's own
# clone would let the user rewrite the script and run it as root.
# setup.sh probes every rule after installing it (sudoers_selftest).

Cmnd_Alias BLINKY_UHUBCTL = @UHUBCTL@ ^-l [0-9.-]+ -p [0-9]+ -a [01]$
Cmnd_Alias BLINKY_MOUNT   = @MKDIR@ ^-p /mnt/uf2-[A-Za-z0-9_-]+$, \
                            @MOUNT@ ^-t vfat -o uid\=[0-9]+\,gid\=[0-9]+\,umask\=022 /dev/sd[a-z]+[0-9]* /mnt/uf2-[A-Za-z0-9_-]+$, \
                            @UMOUNT@ ^/mnt/uf2-[A-Za-z0-9_-]+$, \
                            @UMOUNT@ ^-l /mnt/uf2-[A-Za-z0-9_-]+$, \
                            @RMDIR@ ^/mnt/uf2-[A-Za-z0-9_-]+$
Cmnd_Alias BLINKY_UDISKS  = @SYSTEMCTL@ start udisks2
Cmnd_Alias BLINKY_USBRST  = @PYTHON3@ ^@USB_RESET@ /dev/bus/usb/[0-9]+/[0-9]+$

@USER@ ALL=(root) NOPASSWD: BLINKY_UHUBCTL, BLINKY_MOUNT, BLINKY_UDISKS, BLINKY_USBRST

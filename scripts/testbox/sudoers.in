# blinky test box: passwordless sudo for exactly the commands the flash path
# runs under sudo (tools/uf2_upload.py, blinky-server firmware/uf2_upload.py).
# Everything else still needs the user's password.
# Generated by scripts/testbox/setup.sh from sudoers.in; edit that, not this.

Cmnd_Alias BLINKY_UHUBCTL = @UHUBCTL@ -l * -p * -a 0, @UHUBCTL@ -l * -p * -a 1
Cmnd_Alias BLINKY_MOUNT   = @MKDIR@ -p /mnt/uf2-*, \
                            @MOUNT@ -t vfat -o * /dev/sd* /mnt/uf2-*, \
                            @UMOUNT@ /mnt/uf2-*, @UMOUNT@ -l /mnt/uf2-*, \
                            @RMDIR@ /mnt/uf2-*
Cmnd_Alias BLINKY_UDISKS  = @SYSTEMCTL@ start udisks2
Cmnd_Alias BLINKY_USBRST  = @PYTHON3@ @REPO@/tools/usb_reset.py /dev/bus/usb/*

@USER@ ALL=(root) NOPASSWD: BLINKY_UHUBCTL, BLINKY_MOUNT, BLINKY_UDISKS, BLINKY_USBRST

# /etc/systemd/system/blinky-deploy.service: one deploy pass (scripts/testbox/deploy.py).
# Started by blinky-deploy.timer. Generated by scripts/testbox/setup.sh; edit the .in file.
[Unit]
Description=Deploy blinky-server from master once CI and review pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# The deployer runs from the deploy worktree, so it too is reviewed code from master.
WorkingDirectory=@DEPLOY_DIR@
ExecStart=/usr/bin/python3 @DEPLOY_DIR@/scripts/testbox/deploy.py
# gh's auth, ~/.blinky-api-key and the state file all live in the user's home.
Environment=HOME=@HOME_DIR@
# A console rebuild on the Pi is the slow path (npm ci + vite).
TimeoutStartSec=30min
SyslogIdentifier=blinky-deploy

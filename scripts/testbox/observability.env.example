# The test box's private observability config: the central LGTM stack's push endpoints.
# A template only. The real file is ~/.config/blinky/observability.env on the box (mode 600),
# never committed: this repo is public, and the endpoints are topology. setup.sh (install_alloy)
# reads it and writes the values into /etc/default/alloy, where scripts/testbox/alloy/blinkytest.alloy
# reads them with sys.env(). Change a value: edit the file, then re-run setup.sh.
#
# KEY=value or KEY="value"; parsed, not sourced. The real values are in the owner's private notes
# (and in /etc/default/alloy on a provisioned box). setup.sh refuses these placeholders.

# Loki's push API (a URL)
LOKI_PUSH_URL="http://LGTM_HOST:LOKI_PORT/loki/api/v1/push"
# Prometheus remote write (a URL)
PROM_RW_URL="http://LGTM_HOST:PROM_PORT/api/v1/write"
# Tempo's OTLP/gRPC receiver (host:port, no scheme)
TEMPO_OTLP_ENDPOINT="LGTM_HOST:TEMPO_PORT"

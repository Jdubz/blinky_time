# /etc/systemd/system/blinky-pr-queue.service: one PR hardware queue pass
# (scripts/testbox/pr_queue.py, docs/DEV_LOOP.md "PR hardware queue"). Started by
# blinky-pr-queue.timer. Generated by scripts/testbox/setup.sh; edit the .in file.
[Unit]
Description=Hardware-test firmware PRs to staging on the box's test chips
After=network-online.target blinky-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# From the deploy worktree, like the staging runner: reviewed code from master.
WorkingDirectory=@DEPLOY_DIR@
ExecStart=/usr/bin/python3 @DEPLOY_DIR@/scripts/testbox/pr_queue.py
# gh's auth, ~/.blinky-api-key, ~/.config/blinky/build.env and the state file live in the
# user's home.
Environment=HOME=@HOME_DIR@
# A pass only submits builds and the hardware checks, or polls them (the checks run in blinky-server
# as a durable job, the build on the build service).
TimeoutStartSec=5min
SyslogIdentifier=blinky-pr-queue

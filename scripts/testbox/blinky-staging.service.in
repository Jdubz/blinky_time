# /etc/systemd/system/blinky-staging.service: one staging pass (scripts/testbox/staging.py, #349).
# Started by blinky-staging.timer. Generated by scripts/testbox/setup.sh; edit the .in file.
[Unit]
Description=Hardware-test the staging branch on the box's test chips
After=network-online.target blinky-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# From the deploy worktree, like the deployer: reviewed code from master.
WorkingDirectory=@DEPLOY_DIR@
ExecStart=/usr/bin/python3 @DEPLOY_DIR@/scripts/testbox/staging.py
# gh's auth, ~/.blinky-api-key and the state file all live in the user's home.
Environment=HOME=@HOME_DIR@
# A pass only submits or polls the suite (it runs in blinky-server as a durable job).
TimeoutStartSec=5min
SyslogIdentifier=blinky-staging
